# ─── Service ──────────────────────────────────────────────────
AGENT_HOST=127.0.0.1
AGENT_PORT=4030
# Browser origins allowed to call this service (one regular expression).
# Default allows <slug>.localhost, *.appme.in (tunnel) and *.colegios.in.
AGENT_CORS_ORIGIN_REGEX=

# ─── Upstreams ────────────────────────────────────────────────
SMS_API_URL=http://localhost:4010
SMS_MCP_URL=http://127.0.0.1:4020/mcp
# Same value as MCP_SHARED_SECRET in sms-mcp
SMS_MCP_KEY=

# ─── Model provider (OpenAI) ──────────────────────────────────
OPENAI_API_KEY=
# Default model. A model chosen in the hub (AI > Assistant) overrides it, per
# message. Evaluated on 15 staff tasks (see README): gpt-4.1-nano 30/30 at
# ~$0.22 per 1,000 questions; gpt-5.4-nano ~$0.50; gpt-5.4-mini ~$1.26.
AGENT_MODEL=gpt-4.1-nano
# For AGENT_MODEL only (the hub sets its own). gpt-4.1-*: ignored.
# gpt-5.4-*: none (tools need it). gpt-5 / gpt-5-mini / gpt-5-nano: minimal | low | medium
AGENT_REASONING_EFFORT=none
AGENT_MAX_OUTPUT_TOKENS=1200
AGENT_MAX_TOOL_ROUNDS=6

# ─── Voice ────────────────────────────────────────────────────
# When a model is empty or the key can't use it, the app falls back to the
# browser's own speech recognition / synthesis.
AGENT_VOICE_ENABLED=true
AGENT_STT_MODEL=gpt-4o-mini-transcribe
AGENT_TTS_MODEL=gpt-4o-mini-tts
AGENT_TTS_VOICE=coral
AGENT_MAX_AUDIO_SECONDS=60
AGENT_MAX_AUDIO_BYTES=5242880
AGENT_MAX_SPEAK_CHARS=600

# ─── Human in the loop ────────────────────────────────────────
# agent: this service confirms after the user presses Confirm or says yes.
# user:  the app confirms with the user's own session token first.
# sms-backend's AGENT_CONFIRM_REQUIRES_USER_TOKEN overrides this once it is
# known (it is returned with the quota), so the two cannot disagree.
AGENT_CONFIRM_MODE=agent

# ─── Limits ───────────────────────────────────────────────────
AGENT_MAX_MESSAGE_CHARS=2000
AGENT_MAX_CONVERSATIONS_PER_USER=5
# Earlier exchanges (question + answer) the model sees with each message
AGENT_HISTORY_MAX_TURNS=10
# ...and at most this many characters of them
AGENT_HISTORY_BUDGET_CHARS=24000
AGENT_TOOL_RESULT_MAX_CHARS=6000
# Messages (chat + voice) per user per window
AGENT_RATE_LIMIT=30
AGENT_RATE_WINDOW_SECONDS=300
# Per call to sms-backend
AGENT_REQUEST_TIMEOUT_MS=20000

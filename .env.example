# sms-agent: where things are, and the secrets. Nothing else belongs here:
# the chat model, voice, idle time and history are set per school in the hub
# (AI > Assistant) and reach this service from sms-backend.

AGENT_HOST=127.0.0.1
AGENT_PORT=4030

# sms-backend (no trailing slash) and sms-mcp (private; never published)
SMS_API_URL=http://localhost:4010
SMS_MCP_URL=http://127.0.0.1:4020/mcp
# Same value as MCP_SHARED_SECRET in sms-mcp
SMS_MCP_KEY=

# OpenAI key for chat and, if a school uses server voice, speech
OPENAI_API_KEY=
